---
import { SITE } from "../../site.config.mjs";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="border-b border-(--color-border)">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
    <a href="/" class="text-lg font-semibold tracking-tight hover:opacity-80">
      {SITE.name}
    </a>
    <nav aria-label="Main" class="flex items-center gap-5 text-sm text-(--color-fg-muted)">
      <a href="/about/" class="hover:text-(--color-fg)">About</a>
      <a href="/contact/" class="hover:text-(--color-fg)">Contact</a>
      <ThemeToggle />
    </nav>
  </div>
</header>
