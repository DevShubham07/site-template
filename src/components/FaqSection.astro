---
/**
 * FAQ as VISIBLE CONTENT for long-tail keywords (design doc D-10).
 * Deliberately NO FAQPage JSON-LD: Google removed FAQ rich results for all
 * sites in May 2026 — the markup has no display benefit, the visible answers
 * still earn long-tail traffic.
 */
export interface Props {
  items: { question: string; answer: string }[];
}
const { items } = Astro.props;
---

<section aria-labelledby="faq-heading" class="mt-12">
  <h2 id="faq-heading" class="text-2xl font-semibold tracking-tight">
    Frequently Asked Questions
  </h2>
  <div class="mt-4 divide-y divide-(--color-border)">
    {
      items.map((item) => (
        <details class="group py-3">
          <summary class="cursor-pointer list-none font-medium marker:hidden [&::-webkit-details-marker]:hidden">
            <span class="mr-2 inline-block transition-transform group-open:rotate-90">›</span>
            {item.question}
          </summary>
          <p class="mt-2 pl-5 text-(--color-fg-muted)">{item.answer}</p>
        </details>
      ))
    }
  </div>
</section>
