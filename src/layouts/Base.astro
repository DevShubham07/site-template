---
/**
 * Base layout: every page renders through this.
 * Provides: <Seo>, dark-mode bootstrap, header/footer with legal links,
 * Vercel Web Analytics + Speed Insights (no-ops outside Vercel).
 */
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

export interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;

// Analytics scripts live at /_vercel/* — they only exist on Vercel hosting.
// Including them in local/CI builds produces console 404s, so gate on
// Vercel's build-time env var.
const isVercel = !!process.env.VERCEL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Dark-mode FOUC prevention: set class before first paint.
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (stored === "dark" || (!stored && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <Seo title={title} description={description} image={image} noindex={noindex} />
    <slot name="head" />
    {isVercel && <Analytics />}
    {isVercel && <SpeedInsights />}
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <div class="mesh-glow" aria-hidden="true"></div>
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
