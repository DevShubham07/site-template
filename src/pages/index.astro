---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import FaqSection from "../components/FaqSection.astro";
import { SITE } from "../../site.config.mjs";

const faqItems = [
  {
    question: `What is ${SITE.name}?`,
    answer: "Placeholder FAQ content — replace with real questions once the offering is defined.",
  },
];
---

<Base title={SITE.name} description={SITE.description}>
  <Fragment slot="head">
    <JsonLd organization webApplication />
  </Fragment>

  <h1 class="text-gradient max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">
    {SITE.name}
  </h1>
  <p class="mt-3 max-w-2xl text-lg text-(--color-fg-muted)">{SITE.description}</p>

  <!-- ══════════ MAIN CONTENT AREA (to be built out) ══════════ -->
  <section
    id="content"
    aria-label="Content"
    class="glass mt-8 rounded-2xl p-8 text-center"
  >
    <p class="text-(--color-fg-muted)">Placeholder — main content goes here.</p>
  </section>
  <!-- ══════════ /MAIN CONTENT AREA ══════════ -->

  <!-- ══════════ SEO COPY ══════════ -->
  <article class="prose-custom mt-12 max-w-none">
    <h2 class="text-2xl font-semibold tracking-tight">About {SITE.name}</h2>
    <p class="mt-3 text-(--color-fg-muted)">Placeholder copy — replace with real page content.</p>
  </article>
  <!-- ══════════ /SEO COPY ══════════ -->

  <FaqSection items={faqItems} />
</Base>
