---
import Base from "../layouts/Base.astro";
import { SITE } from "../../site.config.mjs";
---

<Base
  title={`Something Went Wrong — ${SITE.name}`}
  description="An unexpected error occurred."
  noindex
>
  <div class="flex flex-col items-center py-16 text-center">
    <p class="text-6xl font-bold tracking-tight">500</p>
    <h1 class="mt-3 text-2xl font-semibold">Something went wrong</h1>
    <p class="mt-2 max-w-md text-(--color-fg-muted)">
      An unexpected error occurred. Please refresh the page or try again in a moment.
    </p>
    <a
      href="/"
      class="btn-accent mt-6 px-4 py-2 text-sm"
    >
      Back to {SITE.name}
    </a>
  </div>
</Base>
