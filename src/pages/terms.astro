---
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import { SITE } from "../../site.config.mjs";
const updated = "2026-07-14";
---

<Base
  title={`Terms & Conditions — ${SITE.name}`}
  description={`Terms of use for ${SITE.name}: acceptable use, accuracy disclaimer, and liability.`}
>
  <Fragment slot="head">
    <JsonLd breadcrumbs={[{ name: "Home", path: "/" }, { name: "Terms & Conditions" }]} />
  </Fragment>

  <h1 class="text-3xl font-bold tracking-tight">Terms &amp; Conditions</h1>
  <p class="mt-1 text-sm text-(--color-fg-muted)">Last updated: {updated}</p>

  <div class="mt-6 max-w-2xl space-y-6 text-(--color-fg-muted)">
    <section>
      <h2 class="text-xl font-semibold text-(--color-fg)">Use of this site</h2>
      <p class="mt-2">
        {SITE.name} is provided free of charge for personal and commercial use. You agree not to
        misuse the site, attempt to disrupt its operation, or scrape it at abusive volumes.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-(--color-fg)">Accuracy disclaimer</h2>
      <p class="mt-2">
        We work hard to make this tool accurate, and we document its known limitations on the
        page where it appears. However, results are provided “as is,” without warranty of any
        kind. Where a measurement or calculation matters — professionally, medically, legally, or
        financially — always verify with an appropriate professional instrument or advisor.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-(--color-fg)">Limitation of liability</h2>
      <p class="mt-2">
        To the maximum extent permitted by law, {SITE.legalName} shall not be liable for any
        damages arising from the use of, or inability to use, this site or its results.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-semibold text-(--color-fg)">Changes</h2>
      <p class="mt-2">
        We may update these terms from time to time. The “Last updated” date above reflects the
        latest revision; continued use of the site constitutes acceptance of the current terms.
      </p>
    </section>
  </div>
</Base>
